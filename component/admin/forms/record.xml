<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset name="details" label="COM_DECAROPROTOCOL_RECORD_DETAILS">
    <field name="id" type="hidden" />
    <field name="register_id" type="sql" label="COM_DECAROPROTOCOL_REGISTER" required="true" query="SELECT id AS value, title AS text FROM #__decaroprotocol_registers WHERE active=1 ORDER BY ordering,title" key_field="value" value_field="text" />
    <field name="direction" type="list" label="COM_DECAROPROTOCOL_DIRECTION" required="true" default="incoming">
      <option value="incoming">COM_DECAROPROTOCOL_DIRECTION_INCOMING</option>
      <option value="outgoing">COM_DECAROPROTOCOL_DIRECTION_OUTGOING</option>
      <option value="internal">COM_DECAROPROTOCOL_DIRECTION_INTERNAL</option>
    </field>
    <field name="subject" type="textarea" label="COM_DECAROPROTOCOL_SUBJECT" required="true" rows="3" filter="string" />
    <field name="document_date" type="calendar" label="COM_DECAROPROTOCOL_DOCUMENT_DATE" format="%Y-%m-%d" filter="string" showtime="false" />
    <field name="external_reference" type="text" label="COM_DECAROPROTOCOL_EXTERNAL_REFERENCE" maxlength="255" filter="string" />
    <field name="sender" type="textarea" label="COM_DECAROPROTOCOL_SENDER" rows="3" filter="string" />
    <field name="recipients" type="textarea" label="COM_DECAROPROTOCOL_RECIPIENTS" rows="3" filter="string" />
    <field name="notes" type="textarea" label="COM_DECAROPROTOCOL_NOTES" rows="5" filter="string" />
  </fieldset>
</form>
