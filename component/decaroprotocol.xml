<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_DECAROPROTOCOL</name>
  <author>Luca De Caro</author>
  <creationDate>2026-09</creationDate>
  <copyright>Copyright (C) 2026 Luca De Caro. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorUrl>https://github.com/xdecaro/Protocol</authorUrl>
  <version>1.0.0</version>
  <description>COM_DECAROPROTOCOL_XML_DESCRIPTION</description>
  <namespace path="src">Xdecaro\Component\Decaroprotocol</namespace>

  <administration>
    <menu view="dashboard">COM_DECAROPROTOCOL</menu>
    <submenu>
      <menu view="dashboard">COM_DECAROPROTOCOL_DASHBOARD</menu>
      <menu view="records">COM_DECAROPROTOCOL_RECORDS</menu>
      <menu view="registers">COM_DECAROPROTOCOL_REGISTERS</menu>
    </submenu>
    <files folder="admin">
      <filename>access.xml</filename>
      <filename>config.xml</filename>
      <folder>forms</folder>
      <folder>services</folder>
      <folder>sql</folder>
      <folder>src</folder>
      <folder>tmpl</folder>
    </files>
    <languages folder="admin/language">
      <language tag="en-GB">en-GB/com_decaroprotocol.ini</language>
      <language tag="en-GB">en-GB/com_decaroprotocol.sys.ini</language>
      <language tag="it-IT">it-IT/com_decaroprotocol.ini</language>
      <language tag="it-IT">it-IT/com_decaroprotocol.sys.ini</language>
    </languages>
  </administration>

  <media destination="com_decaroprotocol" folder="media">
    <filename>joomla.asset.json</filename>
    <folder>css</folder>
  </media>

  <install>
    <sql>
      <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8mb4.sql</file>
    </sql>
  </install>

  <uninstall>
    <sql>
      <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8mb4.sql</file>
    </sql>
  </uninstall>

  <update>
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
</extension>
